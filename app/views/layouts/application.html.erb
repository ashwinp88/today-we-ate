<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Today We Ate" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Today We Ate">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="<%= asset_path('favicon-32.png') %>" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path('favicon-180.png') %>" sizes="180x180">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% landing_page = controller_name == 'signups' && action_name == 'show' %>
  <% auth_page = controller_name == 'sessions' && %w[new email].include?(action_name) %>
  <% email_signup_page = controller_name == 'users' && %w[new create].include?(action_name) %>
  <% on_home_page = controller_name == 'dashboard' && action_name == 'show' %>
  <% on_meals_page = controller_name == 'meals' %>
  <% on_people_page = controller_name == 'users' && action_name == 'index' %>
  <% on_insights_page = controller_name == 'insights' && action_name == 'show' %>
  <% immersive_background_page = landing_page || auth_page || email_signup_page %>
  <% full_height_page = immersive_background_page || controller_name.in?(%w[dashboard meals users insights]) %>
  <% background_image_for_body = asset_path(session_background_asset.presence || 'banner-1600.jpg') %>
  <% overlay_style = "background-image: linear-gradient(to bottom, rgba(0,0,0,0.45), rgba(0,0,0,0.15)), url('#{background_image_for_body}'); background-size: cover; background-position: center; background-attachment: fixed;" %>
  <body data-theme="white" class="relative z-0 min-h-screen overflow-y-auto text-white" style="<%= overlay_style %>">
    <% show_header = !immersive_background_page && (user_signed_in? || !landing_page) %>
    <% if show_header %>
      <header class="sticky top-0 z-40 border-b border-white/20 bg-white/5 backdrop-blur">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-white/80">
          <%= link_to "Today We Ate", home_path, class: ["text-xs uppercase tracking-[0.35em] transition hover:text-white", on_home_page ? "text-white" : "text-white/60"].join(" ") %>
          <% if user_signed_in? %>
            <nav class="flex flex-wrap items-center justify-end gap-2 sm:gap-4">
              <%= link_to "History", meals_path, class: ["rounded-full px-3 py-1 transition hover:bg-white/10 hover:text-white", on_meals_page ? "bg-white/15 text-white" : "text-white/70"].join(" ") %>
              <%= link_to "Insights", insights_path, class: ["rounded-full px-3 py-1 transition hover:bg-white/10 hover:text-white", on_insights_page ? "bg-white/15 text-white" : "text-white/70"].join(" ") %>
              <%= link_to "People", people_path, class: ["rounded-full px-3 py-1 transition hover:bg-white/10 hover:text-white", on_people_page ? "bg-white/15 text-white" : "text-white/70"].join(" ") %>
              <%= link_to "Sign out", sign_out_path, data: { turbo_method: :delete }, class: "rounded-full px-3 py-1 text-red-200 transition hover:bg-red-500/20 hover:text-red-100" %>
            </nav>
          <% else %>
            <%= link_to "Sign in", login_path, class: "rounded-full border border-white/40 px-4 py-1 text-white hover:bg-white/10" %>
          <% end %>
        </div>
      </header>
    <% end %>

    <% main_classes = if immersive_background_page
        "relative z-10 flex min-h-[90vh] w-full items-center justify-center px-4 py-10 sm:py-16"
      else
        "mx-auto flex w-full max-w-6xl flex-col gap-5 px-4 py-4 pb-1"
      end %>
    <div class="<%= full_height_page ? "min-h-screen flex flex-col" : "" %>">
      <main class="flex-1 <%= main_classes %>">
        <% if flash[:notice].present? || flash[:alert].present? %>
          <div class="w-full">
            <% if flash[:notice].present? && !user_signed_in? %>
              <div class="mb-4 rounded-2xl border border-emerald-200/60 bg-emerald-50/90 px-4 py-3 text-sm font-semibold text-emerald-800 shadow-sm">
                <%= flash[:notice] %>
              </div>
            <% end %>
            <% if flash[:alert].present? %>
              <div class="mb-4 rounded-2xl border border-rose-200/60 bg-rose-50/90 px-4 py-3 text-sm font-semibold text-rose-800 shadow-sm">
                <%= flash[:alert] %>
              </div>
            <% end %>
          </div>
        <% end %>

        <%= yield %>
      </main>

      <%= render "shared/footer", immersive: full_height_page %>
    </div>
  </body>
</html>
