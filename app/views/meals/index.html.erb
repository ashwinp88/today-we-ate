<section class="rounded-3xl border border-white/50 bg-white/90 p-6 shadow-xl backdrop-blur">
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Your meal history</h1>
      <p class="text-sm text-slate-500">A scannable archive of what you've had, how it went, and what might be worth repeating.</p>
    </div>
    <%= link_to "Add another meal", new_meal_path, class: "inline-flex items-center rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
  </div>

  <% if @meals.any? %>
    <div class="space-y-4 lg:hidden">
      <% @meals.each do |meal| %>
        <article class="rounded-3xl border border-slate-100 bg-white p-4 shadow-sm">
          <% if meal.photo.attached? %>
            <div class="mb-4 overflow-hidden rounded-2xl">
              <%= image_tag meal_photo_variant(meal), class: "h-40 w-full object-cover", alt: meal.name %>
            </div>
          <% end %>
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.25em] text-slate-400"><%= meal.ate_on.to_fs(:long) %></p>
              <h2 class="mt-2 text-lg font-semibold text-slate-900"><%= meal.name %></h2>
              <div class="mt-2 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.25em] text-slate-400">
                <span><%= meal_occasion_label(meal.occasion) %></span>
                <span>•</span>
                <span><%= meal.source.titleize %></span>
              </div>
            </div>
            <div><%= rating_stars(meal.rating, size: :sm, show_label: false) %></div>
          </div>
          <% if meal.notes.present? %>
            <p class="mt-3 text-sm text-slate-600"><%= meal.notes %></p>
          <% end %>
          <div class="mt-4 flex flex-wrap gap-2">
            <%= link_to "Edit", edit_meal_path(meal), class: "rounded-full border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100" %>
            <%= button_to "Delete", meal_path(meal), method: :delete, class: "rounded-full bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-500" %>
          </div>
        </article>
      <% end %>
    </div>

    <div class="hidden overflow-x-auto rounded-2xl border border-slate-100 lg:block">
      <table class="min-w-full divide-y divide-slate-100 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
          <tr>
            <th class="px-4 py-3">Date</th>
            <th class="px-4 py-3">Meal</th>
            <th class="px-4 py-3">Occasion</th>
            <th class="px-4 py-3">Source</th>
            <th class="px-4 py-3">Rating</th>
            <th class="px-4 py-3">Try again in</th>
            <th class="px-4 py-3">Notes</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white/60 text-slate-700">
          <% @meals.each do |meal| %>
            <tr>
              <td class="px-4 py-3"><%= meal.ate_on.to_fs(:long) %></td>
              <td class="px-4 py-3 font-semibold text-slate-900">
                <div class="flex items-center gap-3">
                  <% if meal.photo.attached? %>
                    <%= image_tag meal_photo_variant(meal, size: :thumb), class: "h-10 w-10 rounded-xl object-cover", alt: meal.name %>
                  <% end %>
                  <span><%= meal.name %></span>
                </div>
              </td>
              <td class="px-4 py-3"><%= meal_occasion_label(meal.occasion) %></td>
              <td class="px-4 py-3"><%= meal.source.titleize %></td>
              <td class="px-4 py-3"><%= rating_stars(meal.rating, size: :sm, show_label: false) %></td>
              <td class="px-4 py-3"><%= meal.retry_in_days.present? ? pluralize(meal.retry_in_days, "day") : "--" %></td>
              <td class="px-4 py-3"><%= meal.notes.presence || "--" %></td>
              <td class="px-4 py-3 text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to "Edit", edit_meal_path(meal), class: "rounded-full border border-slate-200 px-3 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-100" %>
                  <%= button_to "Delete", meal_path(meal), method: :delete, class: "rounded-full bg-red-600 px-3 py-1 text-xs font-semibold text-white hover:bg-red-500" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-slate-500">You haven't added anything yet. <%= link_to "Start with your latest meal", new_meal_path, class: "font-semibold text-slate-900" %>.</p>
  <% end %>
</section>
