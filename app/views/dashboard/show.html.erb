<% card = "rounded-[28px] border border-white/40 bg-white/90 p-6 shadow-sm backdrop-blur" %>
<% selected_occasion = @dashboard.selected_occasion %>

<section class="rounded-[32px] border border-white/40 bg-white/20 p-6 text-white shadow-[0_24px_70px_rgba(15,23,42,0.35)] backdrop-blur-2xl sm:p-8">
  <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
    <div class="space-y-3">
      <p class="text-[0.65rem] font-semibold uppercase tracking-[0.45em] text-white/70">What should you eat next?</p>
      <h1 class="text-3xl font-semibold leading-tight sm:text-4xl">Welcome back, <%= current_user.first_name %>.</h1>
      <p class="max-w-2xl text-sm text-white/80 sm:text-base">
        Start with something you already love, then see what other people have been into lately.
      </p>
    </div>

    <div class="flex flex-wrap gap-2 text-xs font-semibold uppercase tracking-[0.3em] text-white/80">
      <% Meal.occasions.keys.each do |occasion| %>
        <%= link_to meal_occasion_label(occasion), home_path(occasion: occasion), class: ["rounded-full border px-3 py-2 transition", selected_occasion == occasion ? "border-white bg-white/20 text-white" : "border-white/30 text-white/70 hover:bg-white/10 hover:text-white"].join(" ") %>
      <% end %>
    </div>
  </div>
</section>

<section class="<%= card %>">
  <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500"><%= @dashboard.selected_occasion_label %></p>
      <h2 class="mt-1 text-2xl font-semibold text-slate-900">What's worth eating</h2>
      <p class="text-sm text-slate-500">Your own repeats on one side, fresh inspiration from beyond your usuals on the other.</p>
    </div>
    <%= link_to new_meal_path, class: "inline-flex items-center gap-2 rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-slate-900/15 transition hover:-translate-y-0.5 hover:bg-slate-800" do %>
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-white/10 text-base leading-none">+</span>
      <span>Add</span>
    <% end %>
  </div>

  <div class="grid gap-4 lg:grid-cols-2">
    <section class="rounded-3xl border border-slate-100 bg-slate-50/80 p-4">
      <div class="mb-3 flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500">From your history</p>
          <h3 class="mt-1 text-lg font-semibold text-slate-900">You'd probably love this again</h3>
        </div>
      </div>

      <div class="space-y-3">
        <% @dashboard.personal_recommendations.each do |recommendation| %>
          <article class="rounded-2xl bg-white p-4 shadow-sm">
            <div class="grid gap-4 md:grid-cols-[1fr_220px] md:items-start">
              <div>
                <span class="inline-flex rounded-full px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.25em] <%= recommendation_chip_classes(recommendation[:source_type]) %>"><%= recommendation_chip_label(recommendation[:source_type]) %></span>
                <h4 class="mt-4 text-lg font-semibold text-slate-900"><%= recommendation[:name] %></h4>
                <p class="mt-1 text-sm text-slate-500"><%= recommendation[:reason] %></p>
                <% if recommendation[:occasion].present? %>
                  <p class="mt-2 text-xs font-semibold uppercase tracking-[0.25em] text-slate-400"><%= meal_occasion_label(recommendation[:occasion]) %></p>
                <% end %>
                <div class="mt-4">
                  <%= button_to recommendation_selection_path(name: recommendation[:name], source_type: recommendation[:source_type], occasion: recommendation[:occasion] || selected_occasion), method: :post, class: "inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-900 px-3 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-slate-800" do %>
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 12 2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
                    <span>Tried it</span>
                  <% end %>
                </div>
              </div>
              <% if recommendation[:photo_meal]&.photo&.attached? %>
                <div class="overflow-hidden rounded-2xl border border-slate-100 bg-slate-50 aspect-[4/3]">
                  <%= image_tag meal_photo_variant(recommendation[:photo_meal]), class: "h-full w-full object-cover", alt: recommendation[:name] %>
                </div>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </section>

    <section class="rounded-3xl border border-slate-100 bg-slate-50/80 p-4">
      <div class="mb-3 flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500">From beyond your usuals</p>
          <h3 class="mt-1 text-lg font-semibold text-slate-900">What other people are eating</h3>
        </div>
        <%= link_to "Find people", people_path, class: "text-sm font-semibold text-slate-900 hover:text-slate-700" %>
      </div>

      <% if @dashboard.friend_recommendations.any? %>
        <div class="space-y-3">
          <% @dashboard.friend_recommendations.each do |recommendation| %>
            <article class="rounded-2xl bg-white p-4 shadow-sm">
              <div class="grid gap-4 md:grid-cols-[1fr_220px] md:items-start">
                <div>
                  <span class="inline-flex rounded-full px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.25em] <%= recommendation_chip_classes(recommendation[:source_type]) %>"><%= recommendation_chip_label(recommendation[:source_type]) %></span>
                  <h4 class="mt-4 text-lg font-semibold text-slate-900"><%= recommendation[:name] %></h4>
                  <p class="mt-1 text-sm text-slate-500"><%= recommendation[:reason] %></p>
                  <% if recommendation[:source_type] == "following" && recommendation[:friend_name].present? %>
                    <p class="mt-2 text-xs font-semibold uppercase tracking-[0.25em] text-slate-400">Recently seen from <%= recommendation[:friend_name] %></p>
                  <% end %>
                  <div class="mt-4">
                    <%= button_to recommendation_selection_path(name: recommendation[:name], source_type: recommendation[:source_type], occasion: recommendation[:occasion] || selected_occasion), method: :post, class: "inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-900 px-3 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-slate-800" do %>
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 12 2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
                      <span>Tried it</span>
                    <% end %>
                  </div>
                </div>
                <% if recommendation[:photo_meal]&.photo&.attached? %>
                  <div class="overflow-hidden rounded-2xl border border-slate-100 bg-slate-50 aspect-[4/3]">
                    <%= image_tag meal_photo_variant(recommendation[:photo_meal]), class: "h-full w-full object-cover", alt: recommendation[:name] %>
                  </div>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="rounded-2xl border border-dashed border-slate-200 bg-white/80 p-4 text-sm text-slate-600">
          <p class="font-semibold text-slate-900">Nothing new from other people yet.</p>
          <p class="mt-1">Follow a few more people and this side will start feeling useful fast.</p>
        </div>
      <% end %>
    </section>
  </div>

  <% if @dashboard.cold_start? && @dashboard.fallback_recommendation.present? %>
    <div class="mt-4 rounded-3xl border border-amber-200 bg-amber-50 p-4 text-slate-700">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-600">Cold start</p>
      <p class="mt-2 text-lg font-semibold text-slate-900"><%= @dashboard.fallback_recommendation[:name] %></p>
      <p class="mt-1 text-sm"><%= @dashboard.fallback_recommendation[:reason] %></p>
      <p class="mt-2 text-sm italic text-amber-700">No history, no follows, no shame — mac and cheese still earns the opening recommendation.</p>
    </div>
  <% end %>
</section>

<section class="<%= card %>">
  <div class="mb-4 flex items-center justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-slate-500">Feed</p>
      <h2 class="mt-1 text-xl font-semibold text-slate-900">Latest from people you follow</h2>
    </div>
    <%= link_to "Manage follows", people_path, class: "text-sm font-semibold text-slate-900 hover:text-slate-700" %>
  </div>

  <% if @dashboard.feed_items.any? %>
    <div class="space-y-4">
      <% @dashboard.feed_items.each do |meal| %>
        <article class="rounded-3xl border border-slate-100 bg-slate-50/80 p-4">
          <% if meal.photo.attached? %>
            <div class="mb-4 overflow-hidden rounded-2xl aspect-[4/3] md:ml-auto md:w-[18rem]">
              <%= image_tag meal_photo_variant(meal), class: "h-full w-full object-cover", alt: meal.name %>
            </div>
          <% end %>
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-sm font-semibold text-slate-900"><%= meal.user.name %></p>
              <h3 class="mt-1 text-lg font-semibold text-slate-900"><%= meal.name %></h3>
              <div class="mt-2 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.25em] text-slate-400">
                <span><%= meal.ate_on.to_fs(:long) %></span>
                <span>•</span>
                <span><%= meal.source.titleize %></span>
                <% if meal.occasion.present? %>
                  <span>•</span>
                  <span><%= meal_occasion_label(meal.occasion) %></span>
                <% end %>
              </div>
              <div class="mt-3"><%= rating_stars(meal.rating, size: :sm, show_label: true) %></div>
              <% if meal.notes.present? %>
                <p class="mt-3 text-sm text-slate-600"><%= meal.notes %></p>
              <% end %>
            </div>

            <div class="flex flex-wrap gap-2">
              <% if meal.liked_by?(current_user) %>
                <%= button_to meal_meal_like_path(meal), method: :delete, class: "inline-flex items-center gap-2 rounded-full border border-rose-200 bg-white px-3 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-50" do %>
                  <%= thumbs_up_svg %>
                  <span>Unlike (<%= meal.meal_likes.size %>)</span>
                <% end %>
              <% else %>
                <%= button_to meal_meal_like_path(meal), method: :post, class: "inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100" do %>
                  <%= thumbs_up_svg %>
                  <span>Like (<%= meal.meal_likes.size %>)</span>
                <% end %>
              <% end %>

              <%= button_to recommendation_selection_path(name: meal.name, source_type: "following", occasion: meal.occasion || selected_occasion), method: :post, class: "inline-flex items-center gap-2 rounded-full border border-slate-200 bg-slate-900 px-3 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-slate-800" do %>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 12 2 2 4-4" /><circle cx="12" cy="12" r="9" /></svg>
                <span>Tried it</span>
              <% end %>
            </div>
          </div>

          <div class="mt-4 space-y-3">
            <% if meal.meal_comments.any? %>
              <div class="space-y-2">
                <% meal.meal_comments.limit(3).each do |comment| %>
                  <div class="rounded-2xl bg-white px-3 py-2 text-sm text-slate-600">
                    <span class="font-semibold text-slate-900"><%= comment.user.first_name %>:</span>
                    <%= comment.body %>
                  </div>
                <% end %>
              </div>
            <% end %>

            <%= form_with model: [meal, MealComment.new], class: "flex flex-col gap-2 sm:flex-row" do |form| %>
              <%= form.text_field :body, placeholder: "Ask for the details or say you'd order this too.", class: "w-full rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-900 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
              <%= form.submit "Reply", class: "rounded-full bg-white px-4 py-2 text-sm font-semibold text-slate-900 shadow-sm hover:bg-slate-100" %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-3xl border border-dashed border-slate-200 bg-slate-50 p-6 text-sm text-slate-600">
      <p class="font-semibold text-slate-900">This feed will wake up once you follow a few people.</p>
      <p class="mt-1">That's where the casual inspiration should start to feel alive.</p>
    </div>
  <% end %>
</section>
